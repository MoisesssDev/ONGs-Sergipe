<!DOCTYPE html>
<html>
  <head>
    <title>Connect Sergipe</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag 'ONGsSergipeLogo.png' %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="container d-flex flex-wrap align-items-center justify-content-center justify-content-md-between py-1 mb-2 border-bottom">

      <%= link_to root_path, class: 'text-decoration-none' do %>
        <%= image_tag 'ONGsSergipeLogo.png', width: 80 %>
        <span class="text-gradient-secondary font-title">Connect Sergipe</span>
      <% end %>

      <ul class="nav col-12 col-md-auto mb-2 fw-light justify-content-center mb-md-0">
        <%= link_to 'Página inicial', root_path, class: 'nav-link px-2 text-gradient-primary' %>
        <li><a href="#about" class="nav-link px-2 text-gradient-secondary">Sobre nós</a></li>
        <li><a href="#" class="nav-link px-2 text-gradient-secondary">FAQs</a></li>
      </ul>
    </header>
    <%= yield %>

    <footer class="container-background-gradient-black">
      <div class="py-5">
        
        <nav>
          <ul class="nav justify-content-center">
            <li class="nav-item"><a href="#" class="nav-link px-2 text-gradient-primary">Termos de serviço</a></li>
            <li class="nav-item"><a href="#" class="nav-link px-2 text-gradient-primary">Políticas de privacidade</a></li>
            <li class="nav-item"><a href="#" class="nav-link px-2 text-gradient-primary">Contato</a></li>
          </ul>
        </nav>

        <p class="text-center text-gradient-primary mt-5">
          &copy; <%= Time.current.year %> Connect Sergipe. All rights reserved.
        </p>
      </div>
    </footer>
  </body>
</html>
